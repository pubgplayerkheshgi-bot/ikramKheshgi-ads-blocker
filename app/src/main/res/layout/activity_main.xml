<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#07111F"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- HEADER / INTRO IMAGE -->

        <ImageView
            android:src="@drawable/ikramkheshgi_intro"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:scaleType="centerInside"
            android:contentDescription="ikramKheshgi"/>

        <TextView
            android:text="POWERED BY"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="ikramKheshgi"
            android:textColor="#19B8FF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="POPUP • AD DETECTOR"
            android:textColor="#19B8FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="22dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Detect possible unwanted ads and pop-ups from third-party apps."
            android:textColor="#D9E7F4"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- DETECTOR CONTROL -->

        <Button
            android:id="@+id/enableDetector"
            android:text="ENABLE POPUP DETECTOR"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/scanApps"
            android:text="SCAN INSTALLED APPS"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- STATUS -->

        <TextView
            android:id="@+id/serviceStatus"
            android:text="○ Detector is off"
            android:textColor="#19B8FF"
            android:textStyle="bold"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- DETECTIONS -->

        <TextView
            android:text="Detected Apps"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Possible ad or pop-up sources detected by the monitor."
            android:textColor="#AFC2D4"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <LinearLayout
            android:id="@+id/detectionsContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"/>

        <!-- PRIVACY / SAFETY NOTE -->

        <TextView
            android:text="Only third-party apps are shown in detection results."
            android:textColor="#7FC8FF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- FOOTER -->

        <TextView
            android:text="Powered by ikramKheshgi"
            android:textColor="#19B8FF"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>
