<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#07111F" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <ImageView android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center" android:layout_marginTop="8dp" android:src="@drawable/ikramkheshgi_intro" android:scaleType="centerInside" android:contentDescription="ikramKheshgi" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ikramKheshgi" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POPUP • AD DETECTOR" android:textColor="#19B8FF" android:textSize="15sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Find the app behind an external popup, then open its App Info or Android's uninstall screen." android:textColor="#D9E7F4" android:textSize="15sp" android:gravity="center" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" />
        <TextView android:id="@+id/serviceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ DETECTOR OFF" android:textColor="#19B8FF" android:textStyle="bold" android:textSize="14sp" android:gravity="center" android:padding="14dp" />
        <Button android:id="@+id/enableDetector" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ENABLE POPUP DETECTOR" android:textStyle="bold" android:layout_marginTop="8dp" />
        <Button android:id="@+id/allowOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ALLOW FLOATING DETECTOR" android:textStyle="bold" android:layout_marginTop="7dp" />
        <Button android:id="@+id/scanApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CHECK OVERLAY APPS" android:textStyle="bold" android:layout_marginTop="7dp" />
        <TextView android:id="@+id/detectionCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 popup events identified" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="24dp" />
        <Button android:id="@+id/openLatest" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OPEN LATEST DETECTION" android:layout_marginTop="7dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RECENT DETECTIONS" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" android:layout_marginTop="26dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Only popup-like events are recorded. Normal page changes are not counted." android:textColor="#AFC2D4" android:textSize="13sp" android:layout_marginTop="4dp" />
        <LinearLayout android:id="@+id/historyContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" />
        <Button android:id="@+id/clearHistory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CLEAR DETECTION HISTORY" android:layout_marginTop="10dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Detection is heuristic. Review the identified app before uninstalling it." android:textColor="#7FC8FF" android:textSize="12sp" android:gravity="center" android:layout_marginTop="18dp" android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>
